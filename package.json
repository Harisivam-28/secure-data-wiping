{
  "name": "datashield-forensics",
  "version": "1.0.0",
  "description": "DataShield Forensics - Integrated Secure Data Erasure & Advanced Digital Forensics Engine",
  "main": "main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node start_all.js",
    "start": "node start_all.js",
    "backend": "npm start --prefix backend",
    "frontend": "npm run dev --prefix frontend",
    "test": "npm test --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "electron:dev": "NODE_ENV=development electron .",
    "pack:mac": "npm run build:frontend && electron-builder --mac dir",
    "dist:mac": "npm run build:frontend && electron-builder --mac dmg"
  },
  "build": {
    "appId": "in.gov.sih.datashield",
    "productName": "DataShield Forensics",
    "copyright": "Copyright © 2026 Smart India Hackathon #26149",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "backend/**/*",
      "sample_data/**/*",
      "frontend/dist/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dir",
        "dmg"
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "DataShield Forensics Installer",
      "icon": "build/icon.png",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.16.0"
  },
  "devDependencies": {
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8"
  }
}
